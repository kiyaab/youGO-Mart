# youGO-mart Backend Environment Variables
DJANGO_SECRET_KEY=your-secure-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yougomart.et

# Database Configuration (Leave empty for SQLite or configure PostgreSQL for production)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=yougo_mart_db
# DB_USER=yougo_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432

# Google OAuth Integration
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Administrator Provisioning (for python manage.py bootstrap_admin)
ADMIN_EMAIL=admin@yougomart.et
ADMIN_PASSWORD=SetAStrongPassword2026!
ADMIN_USERNAME=admin

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
